# OneBot implementation platform.
# Supported values: napcat, llonebot, lagrange.
ONEBOT_PLATFORM=napcat

# Container image used by compose.yaml.
# Use onebot-mcp:local after building a local image.
ONEBOT_MCP_IMAGE=ghcr.io/frostbite-time/onebot-mcp:latest

# OneBot action endpoint.
# WebSocket takes precedence when ONEBOT_WS_URL is set.
# If OneBot runs on the Docker host, keep host.docker.internal and adjust the port.
ONEBOT_WS_URL=ws://host.docker.internal:3001
# ONEBOT_HTTP_URL=http://host.docker.internal:3001

# OneBot access token. Leave empty only when your OneBot service has no token.
ONEBOT_TOKEN=change-me

# MCP HTTP endpoint inside the container.
# For Docker deployment this must listen on 0.0.0.0.
ONEBOT_MCP_HOST=0.0.0.0
ONEBOT_MCP_PORT=3000
ONEBOT_MCP_PATH=/mcp

# Host interface used by Docker port publishing.
# 127.0.0.1 keeps the MCP server local to the host.
ONEBOT_MCP_BIND_HOST=127.0.0.1

# Optional bearer token for MCP clients.
# Set a non-empty value if clients outside the same trusted host can reach this port.
ONEBOT_MCP_TOKEN=change-me

# Optional comma-separated browser origins. Requests without Origin are allowed.
ONEBOT_MCP_ALLOWED_ORIGINS=

# Action timeout and maximum MCP JSON-RPC request body size.
ONEBOT_ACTION_TIMEOUT_MS=10000
ONEBOT_MCP_MAX_BODY_BYTES=1048576
